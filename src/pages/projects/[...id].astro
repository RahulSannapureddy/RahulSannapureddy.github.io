---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Rahul Sannapureddy`} description={project.data.description}>
	<a href="/projects" class="back-link">&larr; All projects</a>
	<article>
		<header>
			<h1>{project.data.title}</h1>
			<p class="description">{project.data.description}</p>
			{project.data.tags && (
				<div class="tags">
					{project.data.tags.map(tag => <span>{tag}</span>)}
				</div>
			)}
		</header>
		<hr />
		<div class="prose">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.back-link { display: inline-block; margin-top: 2rem; text-decoration: none; color: var(--text-muted); font-size: 0.9rem; transition: color 0.2s ease; }
	.back-link:hover { color: var(--accent); }
	article { padding: 1rem 0 2rem; }
	header { margin-bottom: 2rem; }
	h1 { margin-bottom: 0.5rem; }
	.description { font-size: 1.2rem; color: var(--text-muted); margin-bottom: 1rem; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.tags span { font-family: var(--font-mono); font-size: 0.8rem; background: var(--tag-bg); padding: 0.2rem 0.5rem; border-radius: 4px; }
	hr { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }
	.prose { line-height: 1.8; }
	.prose h1 { margin-top: 3.5rem; margin-bottom: 1.5rem; color: var(--h1); }
	.prose h2 { margin-top: 3rem; margin-bottom: 1.25rem; color: var(--h2); }
	.prose h3 { margin-top: 2.5rem; margin-bottom: 1rem; color: var(--h3); }
	.prose h4 { margin-top: 2rem; margin-bottom: 0.8rem; color: var(--h4); }
	.prose h5 { margin-top: 1.5rem; margin-bottom: 0.8rem; color: var(--h5); }
	.prose h6 { margin-top: 1.5rem; margin-bottom: 0.8rem; color: var(--h6); }
</style>
