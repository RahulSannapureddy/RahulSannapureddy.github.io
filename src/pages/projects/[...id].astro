---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Rahul Sannapureddy`} description={project.data.description}>
	<a href="/projects" class="back-link">&larr; All projects</a>
	<article>
		<header>
			<div class="title-row">
				<h1>{project.data.title}</h1>
				{project.data.githubUrl && (
					<a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="github-link" title="View on GitHub" aria-label="View source on GitHub">
						<svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
							<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
						</svg>
					</a>
				)}
			</div>
			<p class="description">{project.data.description}</p>
			{project.data.tags && (
				<div class="tags">
					{project.data.tags.map(tag => <span>{tag}</span>)}
				</div>
			)}
		</header>
		<hr />
		<div class="prose">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.back-link { display: inline-block; margin-top: 2rem; text-decoration: none; color: var(--text-muted); font-size: 0.9rem; transition: color 0.2s ease; }
	.back-link:hover { color: var(--accent); }
	article { padding: 1rem 0 2rem; }
	header { margin-bottom: 2rem; }
	.title-row { display: flex; align-items: center; gap: 0.75rem; }
	h1 { margin-bottom: 0.5rem; }
	.github-link {
		display: inline-flex;
		align-items: center;
		color: var(--text-muted);
		transition: color 0.2s ease, transform 0.2s ease;
		margin-bottom: 0.5rem;
		flex-shrink: 0;
	}
	.github-link:hover {
		color: var(--accent);
		transform: scale(1.15);
	}
	.description { font-size: 1.2rem; color: var(--text-muted); margin-bottom: 1rem; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.tags span { font-family: var(--font-mono); font-size: 0.8rem; background: var(--tag-bg); padding: 0.2rem 0.5rem; border-radius: 4px; }
	hr { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }
	.prose { line-height: 1.8; }
	:global(.prose h1) { margin-top: 3.5rem; margin-bottom: 1.5rem; color: var(--h1); }
	:global(.prose h2) { margin-top: 3rem; margin-bottom: 1.25rem; color: var(--h2); }
	:global(.prose h3) { margin-top: 2.5rem; margin-bottom: 1rem; color: var(--h3); }
	:global(.prose h4) { margin-top: 2rem; margin-bottom: 0.8rem; color: var(--h4); }
	:global(.prose h5) { margin-top: 1.5rem; margin-bottom: 0.8rem; color: var(--h5); }
	:global(.prose h6) { margin-top: 1.5rem; margin-bottom: 0.8rem; color: var(--h6); }
</style>
